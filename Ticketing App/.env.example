# ---------------------------------------------------------------------------
# Agent console -> Support Desk API
# ---------------------------------------------------------------------------
# Base URL of the Express service in `SupportDeskApi`. The console at /agent
# calls it directly from the browser, so this must be reachable from the client
# and the API's CORS_ORIGINS must allow this app's origin.
# Defaults to http://localhost:8080 when unset.
NEXT_PUBLIC_SUPPORT_DESK_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Customer portal -> UiPath
# ---------------------------------------------------------------------------
# UiPath integration (server build only). On ticket submit, the app adds a work
# item to an Orchestrator queue, which triggers your Studio Web RPA process.
# Copy to `.env.local` and fill in. If unset, the app still runs and ticket
# creation simply skips the trigger (uipath.skipped = true).

# Automation Cloud base URL (usually the default)
UIPATH_BASE_URL=https://cloud.uipath.com

# Your organization (account) name — first path segment of your cloud URL.
# e.g. https://cloud.uipath.com/sepiaecnvnwd/... -> UIPATH_ORG=sepiaecnvnwd
UIPATH_ORG=sepiaecnvnwd

# Tenant name (Admin -> Tenants)
UIPATH_TENANT=DefaultTenant

# A Personal Access Token (or bearer token) sent as Authorization: Bearer.
# Needs Orchestrator queue permission (OR.Queues) + access to the folder below.
# (The same token also works for the optional Data Service write.)
UIPATH_SECRET=your-pat-or-bearer-token

# Orchestrator folder (OrganizationUnit) id that owns the queue.
# Orchestrator -> your folder -> the numeric Id (visible in the URL).
UIPATH_FOLDER_ID=123456

# The queue the app adds items to; your Queue Trigger starts the process from it.
UIPATH_QUEUE_NAME=Q_Intake

# Intake queue for ticket creation. Defaults to Q_Intake, which has a live consumer.
# Switch to Q_TicketIntake once the Ticket Intake Processor workflow is bound to it.
TICKET_INTAKE_QUEUE=Q_Intake
