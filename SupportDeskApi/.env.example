# ---------------------------------------------------------------- service
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Comma-separated website origins. Use * only locally.
CORS_ORIGINS=*

# ---------------------------------------------------------------- UiPath cloud
UIPATH_BASE_URL=https://cloud.uipath.com
UIPATH_ORG=sepiaecnvnwd
UIPATH_TENANT=DefaultTenant

# External Application with APPLICATION scopes (client credentials).
# Create in Admin -> External Applications, then Add Scopes for Orchestrator + Data Fabric.
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=

# Must be a subset of what the app was granted. If the token request is rejected for an
# unknown scope, copy the exact strings shown on the app page here.
UIPATH_SCOPES="OR.Queues.Read OR.Queues.Write OR.Folders.Read OR.Assets.Read DataService.Data.Read DataService.Data.Write DataService.Schema.Read"

# Folder holding Q_Intake and the ST_* assets.
UIPATH_FOLDER_PATH=Shared
# Preferred over the path — avoids a lookup per request.
UIPATH_FOLDER_KEY=4f02cb81-216b-4944-830a-80acc6c1073b

UIPATH_QUEUE_NAME=Q_Intake

# Docs specify datafabric_/api. Some tenants answer on dataservice_/api instead.
# Verify with GET /api/health/upstream and switch if the Data Fabric checks 404.
DATA_FABRIC_API_SEGMENT=datafabric_/api

# ------------------------------------------------------------ Data Fabric names
ENTITY_TICKET=SupportTicket
ENTITY_COMMENT=TicketComment
ENTITY_EXCEPTION=TicketIntakeException

# ------------------------------------------------------------------ agent auth
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=support-desk-api
JWT_AUDIENCE=support-desk
JWT_TTL_SECONDS=28800

# --------------------------------------------------------------- brand / intake
BRAND_NAME="Maison Fragrance"
SOURCE_SYSTEM=SupportTicketingApp
TICKET_ID_PREFIX=TCK
INTAKE_RATE_LIMIT=20
INTAKE_RATE_WINDOW_MS=60000
